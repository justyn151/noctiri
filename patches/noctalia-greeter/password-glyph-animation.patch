@@ -2,6 +2,7 @@
 
 #include "core/key_modifiers.h"
 #include "core/key_symbols.h"
+#include "render/animation/animation_manager.h"
 #include "render/core/render_styles.h"
 #include "render/scene/glyph_node.h"
 #include "render/text/glyph_registry.h"
@@ -678,6 +679,22 @@ void Input::syncPasswordGlyphNodes(std::size_t count) {
     auto glyph = std::make_unique<GlyphNode>();
     auto* glyphPtr = static_cast<GlyphNode*>(m_textViewport->insertChildAt(2, std::move(glyph)));
     m_passwordGlyphs.push_back(glyphPtr);
+
+    // Make each newly typed password glyph gently pop into place. The glyph
+    // owns the animation, so deleting it also cancels its pending callbacks.
+    if (AnimationManager* animations = animationManager(); animations != nullptr) {
+      glyphPtr->setOpacity(0.0f);
+      glyphPtr->setScale(0.55f);
+      animations->animate(
+          0.0f, 1.0f, 180.0f, Easing::EaseOutBack,
+          [glyphPtr](float value) {
+            glyphPtr->setOpacity(std::min(value * 1.35f, 1.0f));
+            glyphPtr->setScale(0.55f + 0.45f * value);
+          },
+          nullptr, glyphPtr
+      );
+      markPaintDirty();
+    }
   }
 }


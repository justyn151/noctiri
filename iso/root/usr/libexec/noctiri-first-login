#!/usr/bin/env bash
set -Eeuo pipefail

MARKER="${XDG_STATE_HOME:-$HOME/.local/state}/noctiri/initialized"
SRC=/usr/share/noctiri/configs

[[ -e "$MARKER" ]] && exit 0

mkdir -p     "$HOME/.config/niri"     "$HOME/.config/noctalia"     "$HOME/.config/kitty/themes"     "$HOME/.config/qt6ct"     "$HOME/.config/xdg-desktop-portal"     "$HOME/.config/systemd/user/plasma-xdg-desktop-portal-kde.service.d"     "$HOME/.local/share/color-schemes"     "$HOME/Pictures/Screenshots"     "$HOME/Pictures/Wallpapers"     "$(dirname "$MARKER")"

sed "s|@@HOME@@|$HOME|g" "$SRC/niri/config.kdl.in"     > "$HOME/.config/niri/config.kdl"
: > "$HOME/.config/niri/noctalia.kdl"

sed "s|@@HOME@@|$HOME|g" "$SRC/noctalia/config.toml.in"     > "$HOME/.config/noctalia/config.toml"

cp "$SRC/kitty/kitty.conf" "$HOME/.config/kitty/kitty.conf"
: > "$HOME/.config/kitty/themes/noctalia.conf"

sed "s|@@HOME@@|$HOME|g" "$SRC/qt6ct/qt6ct.conf.in"     > "$HOME/.config/qt6ct/qt6ct.conf"

cp "$SRC/kde/kdeglobals" "$HOME/.config/kdeglobals"
cp "$SRC/portals/niri-portals.conf"     "$HOME/.config/xdg-desktop-portal/niri-portals.conf"
cp "$SRC/systemd/kde-portal-override.conf"     "$HOME/.config/systemd/user/plasma-xdg-desktop-portal-kde.service.d/override.conf"

# GUI state can override declarative Noctalia configuration.
rm -f "$HOME/.local/state/noctalia/settings.toml"

touch "$MARKER"

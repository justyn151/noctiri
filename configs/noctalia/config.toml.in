[bar.default]
background_opacity = 0.39999999105930328
capsule = true
capsule_opacity = 0.29999999329447746
capsule_padding = 12.0
capsule_thickness = 0.79999998584389687
center = [ "workspaces" ]
concave_edge_corners = false
end = [ "recording", "media", "tray", "group:g1", "caffeine", "session" ]
margin_edge = 8
margin_ends = 200
padding = 8
panel_overlap = 0
radius = 16
shadow = false
scale = 1.1500000096857548
start = [ "group:g2", "active_window" ]
thickness = 32

    [[bar.default.capsule_group]]
    accordion = false
    accordion_direction = "end"
    border = "primary"
    border_width = 0.5
    enabled = true
    fill = "surface"
    id = "g1"
    members = [ "network", "bluetooth", "brightness" ]
    opacity = 0.0
    padding = 16.0
    widget_spacing = 12

    [[bar.default.capsule_group]]
    accordion = false
    accordion_direction = "end"
    border = "primary"
    border_width = 0.5
    enabled = true
    fill = "surface_variant"
    id = "g2"
    members = [ "clock-time", "-", "clock-date" ]
    opacity = 0.0
    padding = 12.0

[control_center]
show_session_button = false
show_shortcut_labels = false

[dock]
background_opacity = 0.8399999812245369


[notification]
background_opacity = 0.4999999888241291
border = false
history_retention_hours = 168
keep_dismissed_in_history = true
max_visible = 2
offset_x = 12
offset_y = 10
scale = 0.80000000447034836

[osd]
background_opacity = 0.4999999888241291
border = false
offset_y = 24
position = "bottom_center"
scale = 0.80000000447034836

[plugins]
enabled = [ "noctiri/recording" ]

[shell]
button_borders = false
card_borders = false
clipboard_auto_paste = "auto"
clipboard_confirm_clear_history = true
clipboard_enabled = true
clipboard_history_max_entries = 100
clipboard_keep_from_closed_apps = true
corner_radius_scale = 0.85000001266598701
# Keep this generic so Pango/Fontconfig can use Fantasque for Latin and Nerd
# glyphs while falling back to Noto for CJK and other writing systems.
font_family = "sans-serif"
popup_borders = false

    [shell.greeter_sync]
    auto_sync = true

    [shell.launcher]
    categories = false

    [shell.panel]
    borders = false
    transparency_mode = "soft"

    [shell.shadow]
    alpha = 0.39999999105930328

    [shell.screenshot]
    annotate = true
    close_on_copy = true
    close_on_save = true
    confirm_region = false
    copy_to_clipboard = true
    directory = "@@HOME@@/Pictures/Screenshots"
    filename_pattern = "Screenshot_%Y-%m-%d_%H-%M-%S"
    freeze_screen = true
    remember_last_region = false
    save_to_file = true
    show_cursor = false

[theme]
builtin = "Noctalia"
community_palette = "Oxocarbon"
mode = "dark"
source = "builtin"
wallpaper_scheme = "m3-content"

    [theme.templates]
    enable_builtin_templates = true
    builtin_ids = [ "btop", "cava", "kcolorscheme", "kitty", "niri", "qt" ]
    enable_community_templates = true
    community_ids = [ "pywalfox" ]

[wallpaper]
directory = "@@HOME@@/Pictures/Wallpapers"

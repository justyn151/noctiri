#!/usr/bin/env bash
set -Eeuo pipefail

STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_DIR="$STATE_HOME/noctiri"
SNAPSHOT_DIR="$STATE_DIR/snapshots"
REPOSITORY_FILE="$CONFIG_HOME/noctiri/repository"

green=$'\033[1;32m'
yellow=$'\033[1;33m'
red=$'\033[1;31m'
reset=$'\033[0m'
[[ -t 1 ]] || green="" yellow="" red="" reset=""

info() { printf '%s==>%s %s\n' "$green" "$reset" "$*"; }
warn() { printf '%sWarning:%s %s\n' "$yellow" "$reset" "$*" >&2; }
die() { printf '%sError:%s %s\n' "$red" "$reset" "$*" >&2; exit 1; }

run_privileged() {
    if [[ "${NOCTIRI_GUI:-false}" == true ]] && command -v pkexec >/dev/null 2>&1; then
        pkexec "$@"
    else
        sudo "$@"
    fi
}

import_graphical_environment() {
    local process_name process_id name value
    process_id=""
    for process_name in noctalia niri; do
        process_id="$(pgrep -u "$(id -u)" -xo "$process_name" 2>/dev/null || true)"
        [[ -n "$process_id" && -r "/proc/$process_id/environ" ]] && break
        process_id=""
    done
    [[ -n "$process_id" ]] || return 1

    for name in XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS WAYLAND_DISPLAY NIRI_SOCKET; do
        value="$(tr '\0' '\n' < "/proc/$process_id/environ" \
            | sed -n "s/^${name}=//p" | head -n 1)"
        [[ -n "$value" ]] || continue
        export "$name=$value"
    done
}

repository_path() {
    local candidate=""
    if [[ -n "${NOCTIRI_REPO:-}" ]]; then
        candidate="$NOCTIRI_REPO"
    elif [[ -r "$REPOSITORY_FILE" ]]; then
        IFS= read -r candidate < "$REPOSITORY_FILE"
    elif [[ -d "$HOME/Downloads/noctiri/.git" ]]; then
        candidate="$HOME/Downloads/noctiri"
    fi
    [[ -n "$candidate" && -d "$candidate/.git" ]] \
        || die "Noctiri repository not found. Set NOCTIRI_REPO or reinstall the managed configuration."
    printf '%s\n' "$candidate"
}

memory_used_mib() {
    awk '/MemTotal:/ { total=$2 } /MemAvailable:/ { available=$2 } END { printf "%d", (total-available)/1024 }' /proc/meminfo
}

create_snapshot() {
    local reason="${1:-manual}" timestamp target revision="unknown" suffix=0
    local -a candidates paths
    timestamp="$(date +%Y%m%d-%H%M%S)"
    target="$SNAPSHOT_DIR/$timestamp"
    while [[ -e "$target" ]]; do
        ((suffix += 1))
        target="$SNAPSHOT_DIR/$timestamp-$suffix"
    done
    mkdir -p "$target"

    shopt -s nullglob
    candidates=(
        "$CONFIG_HOME/niri"
        "$CONFIG_HOME/noctalia"
        "$CONFIG_HOME/noctiri"
        "$CONFIG_HOME/yazi"
        "$CONFIG_HOME/nvim"
        "$CONFIG_HOME/kitty"
        "$CONFIG_HOME/xdg-desktop-portal"
        "$CONFIG_HOME/quickshell/noctiri-doctor"
        "$CONFIG_HOME/quickshell/noctiri-shortcuts"
        "$HOME/.local/bin/noctiri"*
        "$HOME/.local/share/applications/noctiri-"*.desktop
        "$STATE_HOME/noctalia/settings.toml"
    )
    shopt -u nullglob

    paths=()
    local path
    for path in "${candidates[@]}"; do
        [[ -e "$path" || -L "$path" ]] || continue
        paths+=("${path#"$HOME"/}")
    done
    (( ${#paths[@]} > 0 )) || die "No managed configuration was found to snapshot"

    tar -C "$HOME" -czf "$target/home.tar.gz" -- "${paths[@]}"
    printf '%s\n' "${paths[@]}" > "$target/manifest.txt"
    printf '%s\n' "$reason" > "$target/reason"
    if repo="$(repository_path 2>/dev/null)"; then
        revision="$(git -C "$repo" rev-parse HEAD 2>/dev/null || printf unknown)"
    fi
    printf '%s\n' "$revision" > "$target/revision"
    printf '%s\n' "$target"
}

reload_desktop() {
    if command -v noctalia >/dev/null 2>&1; then
        noctalia msg config-reload >/dev/null 2>&1 || true
        noctalia msg templates-apply >/dev/null 2>&1 || true
    fi
}

validate_desktop() {
    if command -v niri >/dev/null 2>&1 \
        && ! niri validate -c "$CONFIG_HOME/niri/config.kdl" >/dev/null 2>&1; then
        return 1
    fi
    if command -v noctalia >/dev/null 2>&1 \
        && ! noctalia config validate >/dev/null 2>&1; then
        return 1
    fi
}

command_snapshot() {
    local created
    created="$(create_snapshot manual)"
    info "Created snapshot ${created##*/}"
}

command_snapshots() {
    mkdir -p "$SNAPSHOT_DIR"
    printf 'Noctiri configuration snapshots:\n'
    local found=false snapshot reason revision
    while IFS= read -r snapshot; do
        found=true
        reason="$(<"$snapshot/reason")"
        revision="$(<"$snapshot/revision")"
        printf '  %s  %-18s  %.12s\n' "${snapshot##*/}" "$reason" "$revision"
    done < <(find "$SNAPSHOT_DIR" -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null | sort -r)
    [[ "$found" == true ]] || printf '  (none yet)\n'
}

command_rollback() {
    local requested=latest requested_set=false assume_yes=false target before answer argument
    for argument in "$@"; do
        case "$argument" in
            --yes) assume_yes=true ;;
            latest)
                [[ "$requested_set" == false ]] \
                    || die "Usage: noctiri rollback [SNAPSHOT] [--yes]"
                requested=latest
                requested_set=true
                ;;
            -*) die "Usage: noctiri rollback [SNAPSHOT] [--yes]" ;;
            *)
                [[ "$requested_set" == false ]] \
                    || die "Usage: noctiri rollback [SNAPSHOT] [--yes]"
                requested="$argument"
                requested_set=true
                ;;
        esac
    done
    [[ -d "$SNAPSHOT_DIR" ]] || die "No snapshots are available"
    if [[ "$requested" == "latest" ]]; then
        target="$(find "$SNAPSHOT_DIR" -mindepth 1 -maxdepth 1 -type d -print | sort -r | head -n 1)"
    else
        target="$SNAPSHOT_DIR/$requested"
    fi
    [[ -n "$target" && -r "$target/home.tar.gz" ]] || die "Snapshot not found: $requested"

    if [[ "$assume_yes" != true ]]; then
        printf 'Restore configuration snapshot %s? [y/N] ' "${target##*/}"
        read -r answer
        [[ "$answer" =~ ^[Yy]$ ]] || exit 0
    fi

    before="$(create_snapshot before-rollback)"
    info "Safety snapshot created: ${before##*/}"
    tar -C "$HOME" -xzf "$target/home.tar.gz"
    if ! validate_desktop; then
        warn "Restored files did not validate; returning to the pre-rollback state"
        tar -C "$HOME" -xzf "$before/home.tar.gz"
        die "Rollback was rejected by configuration validation"
    fi
    reload_desktop
    info "Restored snapshot ${target##*/}"
    printf 'System packages and the Git checkout were intentionally left unchanged.\n'
}

command_update() {
    local with_system=false repo snapshot before_revision after_revision
    case "${1:-}" in
        "") ;;
        --system) with_system=true ;;
        *) die "Usage: noctiri update [--system]" ;;
    esac
    [[ $# -le 1 ]] || die "Usage: noctiri update [--system]"
    repo="$(repository_path)"

    if [[ -n "$(git -C "$repo" status --porcelain --untracked-files=no)" ]]; then
        die "The Noctiri repository has tracked local changes. Commit or stash them before updating."
    fi

    snapshot="$(create_snapshot before-update)"
    before_revision="$(git -C "$repo" rev-parse --short HEAD)"
    info "Configuration snapshot created: ${snapshot##*/}"
    git -C "$repo" pull --ff-only
    after_revision="$(git -C "$repo" rev-parse --short HEAD)"

    if [[ "$with_system" == true ]]; then
        # shellcheck disable=SC1091
        source /etc/os-release
        case "${ID:-}" in
            void) run_privileged xbps-install -Suy ;;
            *) die "System updates are currently implemented only for Void Linux" ;;
        esac
        if command -v flatpak >/dev/null 2>&1; then
            run_privileged flatpak update --system -y
            flatpak update --user -y || true
        fi
    fi

    if ! bash "$repo/install.sh" --apply-configs-only; then
        warn "The new configuration could not be applied; restoring the pre-update snapshot"
        tar -C "$HOME" -xzf "$snapshot/home.tar.gz"
        validate_desktop || warn "The restored configuration needs attention; run noctiri-doctor"
        reload_desktop
        die "Noctiri update stopped and the previous configuration was restored"
    fi
    reload_desktop
    info "Noctiri updated: $before_revision -> $after_revision"
    printf 'Rollback if needed: noctiri rollback %s\n' "${snapshot##*/}"

    local used
    used="$(memory_used_mib)"
    printf 'Current memory in use: %s MiB\n' "$used"
    (( used <= 1500 )) || warn "Memory is above your 1500 MiB target; run 'noctiri status' after closing active apps."
}

dnd_schedule_valid() {
    [[ "$1" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]
}

dnd_in_window() {
    local now start end
    now="$(date +%H%M)"
    start="${DND_START/:/}"
    end="${DND_END/:/}"
    if (( 10#$start < 10#$end )); then
        (( 10#$now >= 10#$start && 10#$now < 10#$end ))
    else
        (( 10#$now >= 10#$start || 10#$now < 10#$end ))
    fi
}

dnd_daemon() {
    local config="$CONFIG_HOME/noctiri/dnd-schedule.conf"
    local pid_file="$STATE_DIR/dnd-scheduler.pid" marker="$STATE_DIR/dnd-scheduled-active"
    [[ -r "$config" ]] || exit 0
    # This file is written by this command and belongs to the current user.
    # shellcheck disable=SC1090
    source "$config"
    [[ "${DND_ENABLED:-false}" == true ]] || exit 0
    dnd_schedule_valid "${DND_START:-}" && dnd_schedule_valid "${DND_END:-}" || exit 1
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$$" > "$pid_file"
    trap 'rm -f "$pid_file"' EXIT

    while :; do
        if dnd_in_window; then
            if [[ "$(noctalia msg notification-dnd-status 2>/dev/null || true)" != "on" ]]; then
                noctalia msg notification-dnd-set on >/dev/null 2>&1 || true
                : > "$marker"
            fi
        elif [[ -e "$marker" ]]; then
            noctalia msg notification-dnd-set off >/dev/null 2>&1 || true
            rm -f "$marker"
        fi
        sleep 60
    done
}

command_dnd() {
    local action="${1:-status}" config="$CONFIG_HOME/noctiri/dnd-schedule.conf"
    local pid_file="$STATE_DIR/dnd-scheduler.pid"
    case "$action" in
        on|off)
            noctalia msg notification-dnd-set "$action"
            ;;
        toggle)
            noctalia msg notification-dnd-toggle
            ;;
        status)
            printf 'Do Not Disturb: '
            noctalia msg notification-dnd-status 2>/dev/null || printf 'unavailable\n'
            if [[ -r "$config" ]]; then
                # shellcheck disable=SC1090
                source "$config"
                printf 'Schedule: %s to %s (%s)\n' "$DND_START" "$DND_END" "$DND_ENABLED"
            else
                printf 'Schedule: disabled\n'
            fi
            ;;
        schedule)
            [[ $# == 3 ]] || die "Usage: noctiri dnd schedule START END (example: 23:00 07:00)"
            dnd_schedule_valid "$2" && dnd_schedule_valid "$3" || die "Times must use 24-hour HH:MM format"
            mkdir -p "$(dirname "$config")" "$STATE_DIR"
            printf 'DND_ENABLED=true\nDND_START=%q\nDND_END=%q\n' "$2" "$3" > "$config"
            if [[ ! -r "$pid_file" ]] || ! kill -0 "$(<"$pid_file")" 2>/dev/null; then
                nohup "$0" dnd daemon >/dev/null 2>&1 </dev/null &
            fi
            info "DND schedule enabled from $2 to $3"
            ;;
        disable-schedule)
            if [[ -r "$pid_file" ]] && kill -0 "$(<"$pid_file")" 2>/dev/null; then
                kill "$(<"$pid_file")" 2>/dev/null || true
            fi
            mkdir -p "$(dirname "$config")"
            printf 'DND_ENABLED=false\nDND_START=23:00\nDND_END=07:00\n' > "$config"
            rm -f "$pid_file" "$STATE_DIR/dnd-scheduled-active"
            info "DND schedule disabled"
            ;;
        daemon)
            dnd_daemon
            ;;
        *) die "Unknown DND action: $action" ;;
    esac
}

command_status() {
    local repo revision latest="none" used profile="not recorded"
    repo="$(repository_path)"
    revision="$(git -C "$repo" rev-parse --short HEAD)"
    if [[ -r "$CONFIG_HOME/noctiri/install-profile" ]]; then
        IFS= read -r profile < "$CONFIG_HOME/noctiri/install-profile"
    fi
    if [[ -d "$SNAPSHOT_DIR" ]]; then
        latest="$(find "$SNAPSHOT_DIR" -mindepth 1 -maxdepth 1 -type d -print | sort -r | head -n 1)"
        [[ -n "$latest" ]] && latest="${latest##*/}" || latest=none
    fi
    used="$(memory_used_mib)"
    printf 'Repository: %s\nRevision:   %s\nProfile:    %s\nSnapshot:   %s\nMemory:     %s MiB used' \
        "$repo" "$revision" "$profile" "$latest" "$used"
    if (( used > 1500 )); then
        printf ' (above 1500 MiB target)\n'
    else
        printf ' (within target)\n'
    fi
    printf 'DND:        '
    noctalia msg notification-dnd-status 2>/dev/null || printf 'unavailable\n'
}

command_maintenance() {
    command_status
    printf '\n'
    command_snapshots
}

command_memory() {
    local total_mib available_mib used_mib cache_mib shmem_mib pss_total=0
    local slab_mib reclaimable_slab_mib retained_slab_mib unevictable_mib bookkeeping_mib
    local pid pss comm tmp sorted
    total_mib="$(awk '/MemTotal:/ { printf "%d", $2/1024 }' /proc/meminfo)"
    available_mib="$(awk '/MemAvailable:/ { printf "%d", $2/1024 }' /proc/meminfo)"
    used_mib=$((total_mib - available_mib))
    cache_mib="$(awk '/^Cached:/ { cached=$2 } /^Buffers:/ { buffers=$2 } /^SReclaimable:/ { reclaimable=$2 } END { printf "%d", (cached+buffers+reclaimable)/1024 }' /proc/meminfo)"
    shmem_mib="$(awk '/^Shmem:/ { printf "%d", $2/1024 }' /proc/meminfo)"
    slab_mib="$(awk '/^Slab:/ { printf "%d", $2/1024 }' /proc/meminfo)"
    reclaimable_slab_mib="$(awk '/^SReclaimable:/ { printf "%d", $2/1024 }' /proc/meminfo)"
    retained_slab_mib="$(awk '/^SUnreclaim:/ { printf "%d", $2/1024 }' /proc/meminfo)"
    unevictable_mib="$(awk '/^Unevictable:/ { printf "%d", $2/1024 }' /proc/meminfo)"
    bookkeeping_mib="$(awk '/^KernelStack:/ { stack=$2 } /^PageTables:/ { tables=$2 } /^Percpu:/ { percpu=$2 } END { printf "%d", (stack+tables+percpu)/1024 }' /proc/meminfo)"
    tmp="$(mktemp)"
    sorted="$(mktemp)"
    while IFS= read -r pid; do
        pid="${pid//[[:space:]]/}"
        [[ -n "$pid" && -r "/proc/$pid/smaps_rollup" ]] || continue
        pss="$(awk '/^Pss:/ { print $2; exit }' "/proc/$pid/smaps_rollup" 2>/dev/null || true)"
        [[ "$pss" =~ ^[0-9]+$ ]] || continue
        comm="unknown"
        IFS= read -r comm < "/proc/$pid/comm" || true
        printf '%s\t%s\t%s\n' "$pss" "$comm" "$pid" >> "$tmp"
        ((pss_total += pss))
    done < <(ps -o pid= -u "$(id -u)")

    sort -nr "$tmp" > "$sorted"
    printf 'Memory overview\n'
    printf '  Total:             %s MiB\n' "$total_mib"
    printf '  Immediately available: %s MiB (%s%%)\n' \
        "$available_mib" "$((available_mib * 100 / total_mib))"
    printf '  Kernel-reported use: %s MiB\n' "$used_mib"
    printf '  User-session PSS:  %s MiB\n' "$((pss_total / 1024))"
    printf '  Reclaimable cache: %s MiB\n' "$cache_mib"
    printf '  Shared memory:     %s MiB\n' "$shmem_mib"
    printf '  Kernel slab:       %s MiB (%s reclaimable, %s retained)\n' \
        "$slab_mib" "$reclaimable_slab_mib" "$retained_slab_mib"
    printf '  Locked/display pages: %s MiB\n' "$unevictable_mib"
    printf '  Kernel tables/stacks: %s MiB\n' "$bookkeeping_mib"
    printf '\nLargest user-session processes (proportional memory):\n'
    head -n 12 "$sorted" | awk -F '\t' '{printf "  %-22s %6.1f MiB  pid %s\n", $2, $1/1024, $3}'
    printf '\nPSS avoids counting shared libraries once per process. Root-owned services are not\n'
    printf 'included in user-session PSS. The categories above can overlap and should not be added.\n'
    printf '“Available” is the pressure figure; cache and reclaimable slab are released on demand.\n'
    rm -f "$tmp" "$sorted"
}

usage() {
    cat <<'EOF'
Usage: noctiri COMMAND

  status                     Show revision, latest snapshot, DND and memory
  maintenance                Show status and configuration snapshots
  memory                     Explain memory use and list top processes by PSS
  update [--system]          Snapshot, fast-forward, and apply managed configs
  snapshot                   Save managed user configuration now
  snapshots                  List available configuration snapshots
  rollback [SNAPSHOT] [--yes] Restore a snapshot (latest by default)
  dnd on|off|toggle|status   Control Do Not Disturb
  dnd schedule START END     Enable a low-memory daily DND schedule
  dnd disable-schedule       Disable the DND scheduler
EOF
}

import_graphical_environment || true

case "${1:-help}" in
    status) shift; command_status "$@" ;;
    maintenance) shift; command_maintenance "$@" ;;
    memory) shift; command_memory "$@" ;;
    update) shift; command_update "$@" ;;
    snapshot) shift; command_snapshot "$@" ;;
    snapshots) shift; command_snapshots "$@" ;;
    rollback) shift; command_rollback "$@" ;;
    dnd) shift; command_dnd "$@" ;;
    help|-h|--help) usage ;;
    *) die "Unknown command: $1 (try 'noctiri help')" ;;
esac

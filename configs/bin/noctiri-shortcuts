#!/bin/sh

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/noctiri-shortcuts"

# Toggle the existing process first. If no instance exists, start one with its
# window visible; -n prevents duplicates during rapid key presses.
if qs -p "$config_dir" ipc call shortcuts toggle >/dev/null 2>&1; then
    exit 0
fi

exec qs -d -n -p "$config_dir"

#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

notify() {
    if command -v noctalia >/dev/null 2>&1; then
        noctalia msg notification-show "$1" "${2:-}" >/dev/null 2>&1 || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send "$1" "${2:-}" >/dev/null 2>&1 || true
    fi
}

mode=region
audio=false
for arg in "$@"; do
    case "$arg" in
        region|screen|stop|status) mode="$arg" ;;
        --audio) audio=true ;;
        *) printf 'Usage: noctiri-record [region|screen|stop|status] [--audio]\n' >&2; exit 2 ;;
    esac
done

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [[ ! -d "$runtime_dir" ]]; then
    printf 'No XDG runtime directory is available. Start a Niri session first.\n' >&2
    exit 1
fi
state_dir="$runtime_dir/noctiri-record"
mkdir -p -m 700 "$state_dir"
exec 9>"$state_dir/lock"
flock -x 9

pid_file="$state_dir/pid"
path_file="$state_dir/path"
recording_pid=""
recording_path=""
if [[ -r "$pid_file" && -r "$path_file" ]]; then
    IFS= read -r recording_pid < "$pid_file" || true
    IFS= read -r recording_path < "$path_file" || true
fi

recording_active() {
    [[ "$recording_pid" =~ ^[0-9]+$ && -n "$recording_path" ]] || return 1
    kill -0 "$recording_pid" 2>/dev/null || return 1
    [[ -r "/proc/$recording_pid/cmdline" ]] || return 1
    tr '\0' '\n' < "/proc/$recording_pid/cmdline" | grep -Fxq -- "$recording_path"
}

if [[ "$mode" == status ]]; then
    if recording_active; then
        printf 'Recording: %s\n' "$recording_path"
    else
        printf 'Not recording\n'
    fi
    exit 0
fi

if recording_active; then
    kill -INT "$recording_pid"
    for (( attempt=0; attempt<50; attempt++ )); do
        recording_active || break
        sleep 0.1
    done
    if recording_active; then
        notify "Recording is still stopping" "Try the shortcut again in a moment."
        exit 1
    fi
    rm -f -- "$pid_file" "$path_file"
    if [[ -s "$recording_path" ]]; then
        notify "Recording saved" "$recording_path"
        printf 'Saved: %s\n' "$recording_path"
    else
        notify "Recording ended without a video" "Check $state_dir/wf-recorder.log"
        exit 1
    fi
    exit 0
fi

rm -f -- "$pid_file" "$path_file"
[[ "$mode" == stop ]] && exit 0

for dependency in wf-recorder slurp; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
        notify "Screen recording unavailable" "Missing command: $dependency"
        printf 'Missing command: %s\n' "$dependency" >&2
        exit 1
    fi
done

if [[ "$mode" == screen ]]; then
    geometry="$(slurp -o)" || exit 0
else
    geometry="$(slurp)" || exit 0
fi
[[ -n "$geometry" ]] || exit 0

videos_dir="$HOME/Videos"
if command -v xdg-user-dir >/dev/null 2>&1; then
    videos_dir="$(xdg-user-dir VIDEOS)"
    [[ -n "$videos_dir" ]] || videos_dir="$HOME/Videos"
fi
output_dir="$videos_dir/Recordings"
mkdir -p -- "$output_dir"
recording_path="$output_dir/Recording_$(date +%Y-%m-%d_%H-%M-%S)_${RANDOM}.mp4"

args=(-g "$geometry" -f "$recording_path")
[[ "$audio" == true ]] && args+=(--audio)
nohup wf-recorder "${args[@]}" </dev/null 9>&- >"$state_dir/wf-recorder.log" 2>&1 &
recording_pid=$!
printf '%s\n' "$recording_pid" > "$pid_file"
printf '%s\n' "$recording_path" > "$path_file"
sleep 0.5
if ! recording_active; then
    rm -f -- "$pid_file" "$path_file"
    notify "Screen recording failed" "Check $state_dir/wf-recorder.log"
    printf 'wf-recorder exited; see %s/wf-recorder.log\n' "$state_dir" >&2
    exit 1
fi
notify "Screen recording started" "Press either recording shortcut again to stop."
printf 'Recording: %s\n' "$recording_path"

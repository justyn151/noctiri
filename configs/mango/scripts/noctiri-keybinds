#!/bin/sh

cat <<'EOF'
Noctiri Tatami keybindings

Open things
  Super + Return          Kitty terminal
  Super + Space / D       Application launcher
  Super + B               Firefox
  Super + E               Dolphin file manager
  Super + Y               Yazi scratchpad
  Super + W               Wi-Fi manager (nmtui)
  Super + Shift + B       Bluetooth manager (bluetui)
  Super + T               System monitor (btop)
  Super + N               Notification center
  Super + F1              This cheat sheet

Windows and workspaces
  Super + arrows          Focus a window
  Super + J / K           Focus next / previous window
  Super + Shift + arrows  Move a window
  Super + Q               Close the focused window
  Super + F               Toggle fullscreen
  Super + Shift + Space   Toggle floating
  Super + M               Promote to master
  Super + Tab             Cycle tiling layout
  Super + 1..9            Switch workspace
  Super + Shift + 1..9    Move window to workspace

Desktop
  Super + L / Escape      Lock
  Super + Shift + T       Toggle day/night theme
  Super + Shift + R       Reload Mango config
  Print                   Full screenshot
  Shift + Print           Select and edit screenshot
  Super + Shift + E       Exit Mango

Tip: click Wi-Fi or Bluetooth in the top-right bar to open the same TUI managers.
EOF

if [ "${1:-}" = "--hold" ]; then
    printf '\nPress Enter to close...'
    read -r _
fi

#!/bin/sh
set -eu

usage() {
    printf 'Usage: noctiri-theme day|night|toggle [--no-reload]\n' >&2
    exit 2
}

mode="${1:-}"
reload=true
[ "${2:-}" = "--no-reload" ] && reload=false
[ "$#" -le 2 ] || usage

state_dir="${XDG_CONFIG_HOME:-$HOME/.config}/noctiri"
state_file="$state_dir/tatami-theme"
case "$mode" in
    toggle)
        current="$(cat "$state_file" 2>/dev/null || printf night)"
        if [ "$current" = night ]; then mode=day; else mode=night; fi
        ;;
    day|night) ;;
    *) usage ;;
esac

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
for source_path in \
    "$config_home/mango/themes/$mode.conf" \
    "$config_home/mango/kitty-themes/$mode.conf" \
    "$config_home/waybar/themes/$mode.css" \
    "$config_home/fuzzel/themes/$mode.ini" \
    "$config_home/qt6ct/colors/tatami-$mode.conf" \
    "$config_home/btop/themes/tatami-$mode.theme"; do
    [ -f "$source_path" ] || {
        printf 'Missing Tatami theme file: %s\n' "$source_path" >&2
        exit 1
    }
done

ln -sfn "themes/$mode.conf" "$config_home/mango/theme.conf"
ln -sfn "kitty-themes/$mode.conf" "$config_home/mango/kitty-theme.conf"
ln -sfn "themes/$mode.css" "$config_home/waybar/colors.css"
ln -sfn "themes/$mode.ini" "$config_home/fuzzel/fuzzel.ini"
ln -sfn "tatami-$mode.conf" "$config_home/qt6ct/colors/tatami.conf"
ln -sfn "tatami-$mode.theme" "$config_home/btop/themes/tatami.theme"
mkdir -p "$state_dir"
printf '%s\n' "$mode" > "$state_file"

if command -v gsettings >/dev/null 2>&1; then
    if [ "$mode" = night ]; then
        gsettings set org.gnome.desktop.interface color-scheme prefer-dark >/dev/null 2>&1 || true
    else
        gsettings set org.gnome.desktop.interface color-scheme prefer-light >/dev/null 2>&1 || true
    fi
fi

if [ "$reload" = true ]; then
    mmsg dispatch reload_config >/dev/null 2>&1 \
        || mmsg -d reload_config >/dev/null 2>&1 \
        || true
    pkill -USR2 -x waybar >/dev/null 2>&1 || true
    swaync-client -rs >/dev/null 2>&1 || true
fi

printf 'Tatami theme: %s\n' "$mode"

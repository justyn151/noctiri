#!/bin/sh

[ "${1:-}" = post ] || exit 0

user_uid="@@UID@@"

# BlueZ normally reconnects trusted audio devices itself. Make sure the radio
# was not left soft-blocked, and recover bluetoothd only if runit says it died.
if command -v rfkill >/dev/null 2>&1; then
    rfkill unblock bluetooth >/dev/null 2>&1 || true
fi
if [ -e /var/service/bluetoothd ]; then
    case "$(sv status /var/service/bluetoothd 2>/dev/null || true)" in
        run:*) ;;
        *) sv restart /var/service/bluetoothd >/dev/null 2>&1 || true ;;
    esac
fi

# A healthy PipeWire stack survives suspend. If a driver left it wedged, a
# clean restart lets the per-session supervisor recreate all three components
# with the original user D-Bus and XDG runtime environment.
if [ -d "/run/user/$user_uid" ]; then
    pkill -TERM -u "$user_uid" -x wireplumber >/dev/null 2>&1 || true
    pkill -TERM -u "$user_uid" -f '(^|/)pipewire -c pipewire-pulse\.conf$' >/dev/null 2>&1 || true
    pkill -TERM -u "$user_uid" -x pipewire >/dev/null 2>&1 || true
fi


syntax on
filetype plugin indent on

" Translates to <Leader>
let mapleader = "\<Space>"
let maplocalleader = "\<Space>"

" Theme Stuff
set background=dark

" General Stuff
set autoindent
set smartindent
set nowrap
set tabstop=4
set softtabstop=4
set shiftwidth=4
set clipboard=unnamed

nnoremap <Leader>n :set number! relativenumber!<CR>

" Search stuff (move with n or N)
set incsearch
set hlsearch
set ignorecase
set smartcase

nnoremap <Leader><CR> :nohlsearch <CR>
nnoremap n nzz
nnoremap N Nzz

" ============ BOUND =============

nnoremap <Leader>q :q<CR>

" Terminal Keybinds
nnoremap <Leader>t :vertical terminal<CR>
nnoremap <Leader><Leader>t :terminal <CR>
tnoremap <M-e> <C-\><C-n>

" Map to leader key for easier window switching and map arrow keys to resize window
nnoremap <Leader>w <C-w>
nnoremap <Leader><Up> :resize +2<CR>
nnoremap <Leader><Down> :resize -2<CR>
nnoremap <Leader><Left> :vertical resize -2<CR>
nnoremap <Leader><Right> :vertical resize +2<CR>

" :Vex to for vertical tree and :Sex for horizontal tree
nnoremap <Leader>e :Vex<Cr>

" Useful QOL features
vnoremap < <gv
vnoremap > >gv

" ============ BOUND =============

" Vim - Plug installation, check whether plugin is already installed or not
let data_dir = has('nvim') ? stdpath('data') . '/site' : '~/.vim'
if empty(glob(data_dir . '/autoload/plug.vim'))
  silent execute '!curl -fLo '.data_dir.'/autoload/plug.vim --create-dirs  https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
  autocmd VimEnter * PlugInstall --sync | source $MYVIMRC
endif

" Run PlugInstall if there are missing plugins
autocmd VimEnter * if len(filter(values(g:plugs), '!isdirectory(v:val.dir)'))
  \| PlugInstall --sync | source $MYVIMRC
\| endif

" Plugins
call plug#begin()

Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
Plug 'junegunn/fzf.vim'
Plug 'octol/vim-cpp-enhanced-highlight'
Plug 'lervag/vimtex'

" Theme Stuff
Plug 'morhetz/gruvbox'
Plug 'joshdick/onedark.vim'
Plug 'arcticicestudio/nord-vim'

call plug#end()

" Theme Stuff
silent! colorscheme gruvbox

" FZF
nnoremap <Leader>ff :Files<CR>
nnoremap <Leader>fg :Rg<CR>

" VimTeX
let g:vimtex_view_method = 'zathura'
let g:vimtex_compiler_method = 'latexmk'
let g:vimtex_quickfix_mode = 0

" TeX autocomplete: VimTeX omni-completion, then words from open buffers
set autocompletedelay=100
augroup tex_completion
  autocmd!
  autocmd FileType tex setlocal autocomplete complete=o,.,w,b completeopt=menuone,popup,fuzzy
  autocmd FileType tex inoremap <buffer> <silent><expr> <Tab> pumvisible() ? "\<C-n>" : "\<Tab>"
  autocmd FileType tex inoremap <buffer> <silent><expr> <S-Tab> pumvisible() ? "\<C-p>" : "\<S-Tab>"
augroup END
